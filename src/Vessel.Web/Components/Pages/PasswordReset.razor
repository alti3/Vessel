@page "/password-reset"
@attribute [AllowAnonymous]
@layout AuthLayout

<PageTitle>Password reset | Vessel</PageTitle>

<div class="auth-shell">
    <section class="auth-panel">
        <div class="brand brand-auth">
            <span class="brand-mark">V</span>
            <div><strong>Vessel</strong><span>Account recovery</span></div>
        </div>
        @if (HasToken)
        {
            <h1>Choose a new password</h1>
            <p>Enter a new password for <strong>@Email</strong>.</p>
            <form class="form-stack" method="post" action="/auth/password-reset/complete">
                <input type="hidden" name="Email" value="@Email"/>
                <input type="hidden" name="Token" value="@Token"/>
                <label>New password<input name="NewPassword" type="password" autocomplete="new-password" required/></label>
                <button class="button button-primary button-full" type="submit">Set new password</button>
            </form>
        }
        else
        {
            <h1>Reset password</h1>
            @if (Status == "requested")
            {
                <div class="form-alert">If an account exists for that address, a reset link is on its way.</div>
            }
            else if (Status == "invalid")
            {
                <div class="form-alert">The reset link is invalid or expired, or the password was not accepted. Request a new link.</div>
            }
            <p>Enter your email address. Vessel accepts the request without exposing whether the account exists.</p>
            <form class="form-stack" method="post" action="/auth/password-reset/request">
                <label>Email<input name="Email" type="email" autocomplete="email" required/></label>
                <button class="button button-primary button-full" type="submit">Request reset</button>
            </form>
        }
        <div class="auth-links"><a href="/login">Back to login</a></div>
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    public string? Status { get; set; }

    private bool HasToken => !string.IsNullOrWhiteSpace(Token) && !string.IsNullOrWhiteSpace(Email);
}
